# 股票玄学多模型研究平台 · NAS 部署配置
# 复制为 .env 后按需修改；不改也能跑（默认值已避让 NAS 上现有服务端口）

# --- 对外端口（务必避开 NAS 上已占用的端口）---
# 已占用参考：18001 stock-analyzer-api / 18642+19119 hermes / 18789-18790 openclaw / 6379 redis
SMP_API_PORT=18080
SMP_WEB_PORT=13000

# --- 你的供应商数据路径（只读挂载，容器无法修改）---
SMP_VENDOR_HOST_PATH=/vol1/1000/股票历史数据

# --- 行情源 ---
# vendor_parquet = 全市场供应商 Parquet 仓库（Phase 4 默认）
# offline        = 老的文件型通道（data/import/，仅 100 只）
SMP_MARKET_PROVIDER=vendor_parquet

# --- LLM 叙事（可选，留空则该功能降级，其余页面正常）---
SMP_LLM_API_KEY=
SMP_LLM_BASE_URL=
